# Packaging environment for the custom Desktop build.
# Copied to <checkout>/apps/desktop/.env.windows by build-release.ps1.
#
# App id: the packaged application's identity (installer registry keys, taskbar identity, update
# publisher). Deliberately distinct from the official com.deepseek.harness so a side-by-side
# install stays separate.
DSH_DESKTOP_APP_ID=com.github.blue-soda.dsh-desktop

# Production deployment selects DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN and anonymous policy
# authentication, so no login origins are configured.
DSH_DESKTOP_AUTO_UPDATE_ENV=production

# PLACEHOLDER: replace with an HTTPS origin that answers
# GET /api/v0/check_client_update with {"code":0,"data":{"biz_code":0,"biz_data":null}}.
# An origin that answers nothing leaves the app reporting that update requirements could not be
# checked; it does not block startup.
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://policy.invalid.example

# Optional npm registry for the bundled runtime install; defaults to https://registry.npmjs.org/.
# A local mirror such as https://registry.npmmirror.com survives a slow or blocked default.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
