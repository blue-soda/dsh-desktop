diff --git a/apps/desktop/src/bundled-extras.ts b/apps/desktop/src/bundled-extras.ts
new file mode 100644
index 0000000000..46461ddf83
--- /dev/null
+++ b/apps/desktop/src/bundled-extras.ts
@@ -0,0 +1,82 @@
+/** Third-party bundles a custom distribution ships inside the Desktop runtime. */
+
+import { existsSync, readFileSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+/**
+ * Bundle package names every newly created Desktop profile enables after its template bundles.
+ * The runtime project installs them from the configured registry, so the packaged application
+ * carries them without a vendored tarball.
+ */
+export const BUNDLED_EXTRA_BUNDLES: readonly string[] = ['@blue-soda/dsh-remote']
+
+/** Registry spec the runtime project depends on; the caret keeps plugin patch releases flowing into builds. */
+export const BUNDLED_EXTRA_SPEC = '^0.4.28'
+
+/**
+ * Loader patch entries a newly created profile starts with.
+ * The bundle defaults to one role and the plugin author's relay, so this distribution pins both
+ * roles against its own server. Users edit these entries like any other profile patch.
+ */
+export const BUNDLED_EXTRA_PATCH: readonly string[] = [
+  '- id: ds-harness-remote',
+  '  config:',
+  '    enabled: true',
+  '    role: both',
+  '    serverUrl: https://sakakibara.ink:8443',
+  '    codex:',
+  '      enabled: true',
+]
+
+/** A line that begins a patch entry; a profile patch without one carries no overrides yet. */
+const PATCH_ENTRY = /^\s*-\s/m
+
+/** Package whose manifest anchors the installation scope a profile boot resolves rows through. */
+const DSH_PACKAGE = '@deepseek-ai/dsh'
+
+/**
+ * Registry dependencies the runtime project installs beside the verified core package set.
+ * @returns Dependency map from bundle package name to its registry spec.
+ */
+export function bundledExtraDependencies(): Record<string, string> {
+  return Object.fromEntries(BUNDLED_EXTRA_BUNDLES.map(name => [name, BUNDLED_EXTRA_SPEC]))
+}
+
+/**
+ * Seed a new profile's patch layer with the distribution entries, keeping the template comments.
+ * A patch that already carries entries is left untouched, so user edits always win.
+ * @param patchPath - Profile patch file written by profile initialization.
+ */
+export function seedBundledExtraPatch(patchPath: string): void {
+  if (!existsSync(patchPath)) return
+  const current = readFileSync(patchPath, 'utf8')
+  if (PATCH_ENTRY.test(current)) return
+  const comments = current.split('\n').filter(line => line.startsWith('#'))
+  writeFileSync(patchPath, `${[...comments, ...BUNDLED_EXTRA_PATCH].join('\n')}\n`, { mode: 0o600 })
+}
+
+/**
+ * Declare the bundled bundles in the installed dsh manifest.
+ * A profile boot maps a loader row's bare package name through the installation's dependency graph,
+ * so a bundled row that no installation manifest declares cannot be imported and its entry never
+ * receives a fiber. The runtime project manifest is not that graph; the installed dsh package is.
+ * @param runtimeRoot - Materialized runtime root holding the installed packages.
+ * @returns Declared package names mapped to the version spec that was written.
+ */
+export function declareBundledExtras(runtimeRoot: string): Record<string, string> {
+  const manifestPath = join(runtimeRoot, 'node_modules', DSH_PACKAGE, 'package.json')
+  const manifest = JSON.parse(readFileSync(manifestPath, 'utf8')) as {
+    dependencies?: Record<string, string>
+  }
+  const declared: Record<string, string> = {}
+  for (const name of BUNDLED_EXTRA_BUNDLES) {
+    const installed = join(runtimeRoot, 'node_modules', ...name.split('/'), 'package.json')
+    if (!existsSync(installed)) throw new Error(`desktop bundled extras: ${name} is missing from ${runtimeRoot}`)
+    const version = (JSON.parse(readFileSync(installed, 'utf8')) as { version?: string }).version
+    if (version === undefined) throw new Error(`desktop bundled extras: ${name} declares no version`)
+    declared[name] = version
+  }
+  manifest.dependencies = { ...manifest.dependencies, ...declared }
+  writeFileSync(manifestPath, `${JSON.stringify(manifest, undefined, 2)}\n`)
+  return declared
+}
diff --git a/apps/desktop/src/defender-exclusion.ts b/apps/desktop/src/defender-exclusion.ts
new file mode 100644
index 0000000000..c950e4f477
--- /dev/null
+++ b/apps/desktop/src/defender-exclusion.ts
@@ -0,0 +1,88 @@
+/** One-time offer to exclude this installation from Windows Security real-time scanning. */
+
+import { spawn } from 'node:child_process'
+import { existsSync, readFileSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { app, dialog, type BrowserWindow, type MessageBoxOptions } from 'electron'
+import type { DesktopMessages } from './locale.ts'
+
+/** Marker under userData whose presence settles the offer for this installation. */
+const OFFER_MARKER = 'defender-exclusion-settled'
+
+/** Shipped script name, matching the Windows `extraResources` entry. */
+const SCRIPT_FILE = 'defender-exclusions.cmd'
+
+/** Result file the script writes under the system temporary directory. */
+const RESULT_FILE = 'dsh-defender-exclusions.json'
+
+/** Reason the script records when the authorization prompt was dismissed. */
+const DECLINED_REASON = 'authorization-declined'
+
+/**
+ * Whether the script recorded a dismissed authorization prompt instead of a failure.
+ * @returns True when the result file reports the declined path.
+ */
+function recordedDecline(): boolean {
+  try {
+    const value: unknown = JSON.parse(readFileSync(join(app.getPath('temp'), RESULT_FILE), 'utf8'))
+    return typeof value === 'object' && value !== null && 'reason' in value && value.reason === DECLINED_REASON
+  } catch {
+    // A missing or unreadable result file means the script never reported the declined path.
+    return false
+  }
+}
+
+/**
+ * Run the shipped exclusion script, which requests its own elevation.
+ * @param scriptPath - Absolute path of the packaged script.
+ * @returns True when the script exited successfully.
+ */
+function runExclusionScript(scriptPath: string): Promise<boolean> {
+  return new Promise((settle) => {
+    const systemRoot = process.env.SystemRoot ?? 'C:\\Windows'
+    const shell = join(systemRoot, 'System32', 'cmd.exe')
+    const child = spawn(shell, ['/c', scriptPath], { stdio: 'ignore', windowsHide: true })
+    // A spawn failure and a non-zero exit both leave the exclusions unapplied.
+    child.once('error', () => { settle(false) })
+    child.once('close', (code) => { settle(code === 0) })
+  })
+}
+
+/**
+ * Offer the Windows Security exclusion once per installation.
+ * The question precedes the authorization prompt, so the elevation request arrives after the user
+ * has read what it changes. Declining is recorded, and the offer never returns.
+ * @param options - Parent window lookup and the shell copy for the active locale.
+ */
+export async function offerDefenderExclusion(options: {
+  readonly parent: () => BrowserWindow | undefined
+  readonly messages: DesktopMessages
+}): Promise<void> {
+  if (process.platform !== 'win32' || !app.isPackaged) return
+  const markerPath = join(app.getPath('userData'), OFFER_MARKER)
+  if (existsSync(markerPath)) return
+  const scriptPath = join(process.resourcesPath, SCRIPT_FILE)
+  if (!existsSync(scriptPath)) return
+  const window = options.parent()
+  const show = async (message: MessageBoxOptions): Promise<number> =>
+    (window === undefined ? dialog.showMessageBox(message) : dialog.showMessageBox(window, message))
+      .then(result => result.response)
+  const { messages } = options
+  const response = await show({
+    type: 'question',
+    title: messages.defenderTitle,
+    message: messages.defenderMessage,
+    detail: messages.defenderDetail,
+    buttons: [messages.defenderAdd, messages.defenderLater],
+    defaultId: 0,
+    cancelId: 1,
+  })
+  writeFileSync(markerPath, `${String(response)}\n`, { mode: 0o600 })
+  if (response !== 0) return
+  if (await runExclusionScript(scriptPath)) return
+  await show({
+    type: 'info',
+    title: messages.defenderTitle,
+    message: recordedDecline() ? messages.defenderDeclined : messages.defenderFailed,
+  })
+}
