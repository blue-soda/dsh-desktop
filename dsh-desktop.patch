diff --git a/apps/desktop/resources/defender-exclusions.cmd b/apps/desktop/resources/defender-exclusions.cmd
new file mode 100644
index 0000000000..2b9636552f
--- /dev/null
+++ b/apps/desktop/resources/defender-exclusions.cmd
@@ -0,0 +1,50 @@
+@echo off
+rem Add or remove the Windows Security exclusions that keep this installation off the
+rem real-time scan path. The application runs this file on its first packaged launch.
+rem
+rem Running without administrator rights relaunches this file elevated, which shows a UAC
+rem prompt. Windows exposes the exclusion list only through Add-MpPreference, so each write
+rem below is an inline call into the system PowerShell; this file holds the whole script.
+setlocal EnableExtensions EnableDelayedExpansion
+
+set "MODE=add"
+if /i "%~1"=="remove" set "MODE=remove"
+if /i "%~1"=="-Remove" set "MODE=remove"
+
+fltmc >nul 2>&1
+if errorlevel 1 (
+  echo Requesting administrator authorization for the Windows Security exclusions...
+  powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -ArgumentList '%MODE%' -Verb RunAs"
+  if errorlevel 1 (
+    > "%TEMP%\dsh-defender-exclusions.json" echo {"elevated": false, "reason": "authorization-declined"}
+    exit /b 1
+  )
+  exit /b 0
+)
+
+rem The script sits in <install>\resources, so its parent is the installation directory.
+for %%I in ("%~dp0..") do set "INSTALL_ROOT=%%~fI"
+set "HARNESS_HOME=%USERPROFILE%\.dsh"
+set "APPLIED="
+set "MISSING="
+set "FAILED="
+
+for %%P in ("%INSTALL_ROOT%" "%HARNESS_HOME%") do (
+  if exist "%%~fP" (
+    if /i "%MODE%"=="remove" (
+      powershell -NoProfile -Command "Remove-MpPreference -ExclusionPath '%%~fP' -ErrorAction Stop" 1>nul 2>nul
+    ) else (
+      powershell -NoProfile -Command "Add-MpPreference -ExclusionPath '%%~fP' -ErrorAction Stop" 1>nul 2>nul
+    )
+    if errorlevel 1 ( set "FAILED=!FAILED! %%~fP" ) else ( set "APPLIED=!APPLIED! %%~fP" )
+  ) else (
+    set "MISSING=!MISSING! %%~fP"
+  )
+)
+
+echo Windows Security exclusion %MODE% finished.
+if defined APPLIED echo   applied:!APPLIED!
+if defined MISSING echo   missing:!MISSING!
+if defined FAILED echo   failed:!FAILED!
+if defined FAILED exit /b 1
+exit /b 0
