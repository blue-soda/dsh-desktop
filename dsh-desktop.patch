diff --git a/apps/desktop/tests/bundled-extras.spec.ts b/apps/desktop/tests/bundled-extras.spec.ts
new file mode 100644
index 0000000000..dbf78ddca0
--- /dev/null
+++ b/apps/desktop/tests/bundled-extras.spec.ts
@@ -0,0 +1,76 @@
+/** Patch seeding for the bundles a custom distribution ships inside the Desktop runtime. */
+
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, it } from 'vitest'
+import { BUNDLED_EXTRA_PATCH, declareBundledExtras, seedBundledExtraPatch } from '../src/bundled-extras.ts'
+
+/** The empty patch a profile template writes before any user edit. */
+const TEMPLATE_PATCH = '# Your patch layer for this dsh profile, applied after every bundle layer:\n'
+  + '# a top-level YAML array of loader patch entries (id-targeted config\n'
+  + '# overrides, disables, and insert lists; `!!js` expressions allowed).\n'
+  + '[]\n'
+
+it('replaces an untouched template patch with the distribution entries', () => {
+  const home = mkdtempSync(join(tmpdir(), 'dsh-bundled-extras-'))
+  try {
+    const patchPath = join(home, 'cordis.patch.yml')
+    writeFileSync(patchPath, TEMPLATE_PATCH)
+    seedBundledExtraPatch(patchPath)
+    const written = readFileSync(patchPath, 'utf8')
+    expect(written).toContain('# Your patch layer for this dsh profile')
+    for (const line of BUNDLED_EXTRA_PATCH) expect(written).toContain(line)
+  } finally {
+    rmSync(home, { recursive: true, force: true })
+  }
+})
+
+it('keeps a patch that already carries user entries', () => {
+  const home = mkdtempSync(join(tmpdir(), 'dsh-bundled-extras-'))
+  try {
+    const patchPath = join(home, 'cordis.patch.yml')
+    const existing = `${TEMPLATE_PATCH}# keep me\n- id: ui-settings\n  config:\n    enabled: false\n`
+    writeFileSync(patchPath, existing)
+    seedBundledExtraPatch(patchPath)
+    expect(readFileSync(patchPath, 'utf8')).toBe(existing)
+  } finally {
+    rmSync(home, { recursive: true, force: true })
+  }
+})
+
+/** Materialize a runtime root carrying one installed extra and one installed dsh manifest. */
+function runtimeFixture(extra: boolean): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-bundled-extras-'))
+  const dshDir = join(root, 'node_modules', '@deepseek-ai', 'dsh')
+  mkdirSync(dshDir, { recursive: true })
+  writeFileSync(join(dshDir, 'package.json'), JSON.stringify({
+    name: '@deepseek-ai/dsh', version: '0.2.1-alpha.1', dependencies: { '@deepseek-ai/dsh-base': '0.2.1-alpha.1' },
+  }))
+  if (extra) {
+    const extraDir = join(root, 'node_modules', '@blue-soda', 'dsh-remote')
+    mkdirSync(extraDir, { recursive: true })
+    writeFileSync(join(extraDir, 'package.json'), JSON.stringify({ name: '@blue-soda/dsh-remote', version: '0.4.28' }))
+  }
+  return root
+}
+
+it('declares a bundled extra in the installed dsh manifest', () => {
+  const root = runtimeFixture(true)
+  try {
+    expect(declareBundledExtras(root)).toEqual({ '@blue-soda/dsh-remote': '0.4.28' })
+    const manifest = JSON.parse(readFileSync(join(root, 'node_modules', '@deepseek-ai', 'dsh', 'package.json'), 'utf8'))
+    expect(manifest.dependencies).toEqual({ '@deepseek-ai/dsh-base': '0.2.1-alpha.1', '@blue-soda/dsh-remote': '0.4.28' })
+  } finally {
+    rmSync(root, { recursive: true, force: true })
+  }
+})
+
+it('refuses a runtime that omits a bundled extra', () => {
+  const root = runtimeFixture(false)
+  try {
+    expect(() => declareBundledExtras(root)).toThrow('@blue-soda/dsh-remote is missing')
+  } finally {
+    rmSync(root, { recursive: true, force: true })
+  }
+})
